<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
    <children>
        <TextField layoutX="125.0" layoutY="101.0" onAction="#enterPurposeTF" />
        <TextField layoutX="125.0" layoutY="153.0" onAction="#enterAmountTF" />
        <Text layoutX="241.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Advances and Claims" />
        <Text layoutX="40.0" layoutY="119.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Enter Purpose" />
        <Text layoutX="41.0" layoutY="171.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Enter Amount" />
        <Button layoutX="30.0" layoutY="275.0" mnemonicParsing="false" onAction="#requestClarificationOA" text="Request Clarification" />
        <Button layoutX="279.0" layoutY="275.0" mnemonicParsing="false" onAction="#processPaymentOA" text="Process Payment" />
        <Button layoutX="474.0" layoutY="275.0" mnemonicParsing="false" onAction="#uploadReceiptOA" text="Upload Receipt" />
        <Button layoutX="479.0" layoutY="344.0" mnemonicParsing="false" onAction="#submitClaimOA" text="Submit Claim" />
        <Button layoutX="41.0" layoutY="351.0" mnemonicParsing="false" onAction="#backOA" text="Back" />
        <ChoiceBox fx:id="selectClaimCB" layoutX="390.0" layoutY="101.0" prefWidth="150.0" />
        <Text layoutX="300.0" layoutY="119.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Select Claim" />
    </children>
</AnchorPane>
