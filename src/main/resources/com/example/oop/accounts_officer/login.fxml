<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Shilpakala Academy Login">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <TextField fx:id="userIDField" promptText="User ID (8 digits)" />
    <PasswordField fx:id="passwordField" promptText="Password (4 digits)" />

    <Button text="Login" onAction="#handleLogin" />

    <Button text="Forgot Password" onAction="#handleForgotPassword" />

    <Label text="New User?" />
    <Button text="Sign Up" onAction="#handleSignUpRedirect" />
</VBox>
